SERVER_PORT=8000
DATABASE_NAME=zhitoubao
DATABASE_USERNAME=zhitoubao
DATABASE_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
# 30 days. Applies to newly issued tokens; existing tokens keep their expiry.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Account recovery/email changes: configure a verified SMTP sender before enabling.
# 587 requires STARTTLS; for implicit TLS use port 465 and ACCOUNT_SMTP_SSL=true.
ACCOUNT_EMAIL_ENABLED=false
ACCOUNT_SMTP_HOST=
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USERNAME=
ACCOUNT_SMTP_PASSWORD=
ACCOUNT_EMAIL_FROM=
ACCOUNT_SMTP_SSL=false

BINANCE_LIVE_TRADING=false
BINANCE_TESTNET_REST_BASE_URL=https://testnet.binance.vision
BINANCE_PRODUCTION_REST_BASE_URL=https://api.binance.com
BINANCE_MARKET_STREAM_URL=wss://stream.binance.com:9443
BINANCE_MARKET_STREAM_MAX_MESSAGE_SIZE=1048576
MARKET_STREAM_ENABLED=false
SCHEDULING_ZONE=Asia/Shanghai
ORDER_RECONCILIATION_STALE_AGE=PT30S
ORDER_RECONCILIATION_MAX_ATTEMPTS=20

# Bark 通知：部署前生成并填写独立加密密钥；管理员地址可留空。
BARK_USER_NOTIFICATIONS_ENABLED=true
BARK_ADMIN_PUSH_URL=
BARK_ALLOWED_HOSTS=api.day.app
BARK_ALLOW_PRIVATE_HOSTS=false
BARK_CREDENTIAL_ENCRYPTION_KEY=
# Exchange API secrets are encrypted at rest with this 32-byte Base64 key (openssl rand -base64 32).
# Empty = reuse BARK_CREDENTIAL_ENCRYPTION_KEY. Do not change it once secrets are stored, or they cannot be decrypted.
EXCHANGE_CREDENTIAL_ENCRYPTION_KEY=
# Independent Webhook signing-secret encryption key: openssl rand -base64 32
# Leave empty to allow drafts only; activation remains unavailable.
WEBHOOK_CREDENTIAL_ENCRYPTION_KEY=
# Outbound reminders, separate from incoming webhook alerts. Generate with openssl rand -base64 32.
# Preserve the key across deployments after users save destinations.
OUTBOUND_WEBHOOK_ENABLED=false
OUTBOUND_WEBHOOK_ENCRYPTION_KEY=
BARK_NOTIFY_ON_STARTUP=false
BARK_DISPATCH_ENABLED=true
APP_PUBLIC_URL=

WORDPRESS_ENDPOINT_URL=https://multind.com
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:*,http://127.0.0.1:*

# F&G futures execution. Keep disabled until a Binance USDT-M testnet key is configured.
FNG_EXECUTION_ENABLED=false
BINANCE_FUTURES_TESTNET_REST_BASE_URL=https://testnet.binancefuture.com
BINANCE_FUTURES_PRODUCTION_REST_BASE_URL=https://fapi.binance.com
FNG_EXECUTION_POLL_DELAY=5000
FNG_EXECUTION_INITIAL_DELAY=15000
