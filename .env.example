SERVER_PORT=8000
DATABASE_NAME=zhitoubao
DATABASE_USERNAME=zhitoubao
DATABASE_PASSWORD=replace-with-local-database-password
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
JWT_SECRET_KEY=replace-with-at-least-32-random-characters

BINANCE_LIVE_TRADING=false
BINANCE_TESTNET_REST_BASE_URL=https://testnet.binance.vision
BINANCE_PRODUCTION_REST_BASE_URL=https://api.binance.com
BINANCE_MARKET_STREAM_URL=wss://stream.binance.com:9443
MARKET_STREAM_ENABLED=false
SCHEDULING_ZONE=Asia/Shanghai
ORDER_RECONCILIATION_STALE_AGE=PT30S
ORDER_RECONCILIATION_MAX_ATTEMPTS=20

# Bark 通知：部署前生成并填写独立加密密钥；管理员地址可留空。
BARK_USER_NOTIFICATIONS_ENABLED=true
BARK_ADMIN_PUSH_URL=
BARK_ALLOWED_HOSTS=api.day.app
BARK_ALLOW_PRIVATE_HOSTS=false
BARK_CREDENTIAL_ENCRYPTION_KEY=
BARK_NOTIFY_ON_STARTUP=false
BARK_DISPATCH_ENABLED=true
APP_PUBLIC_URL=

WORDPRESS_ENDPOINT_URL=https://multind.com
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:*,http://127.0.0.1:*
